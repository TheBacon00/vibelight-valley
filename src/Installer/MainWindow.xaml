<Window x:Class="VibelightValley.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vibelight Valley Installer" Width="560" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <StackPanel>
            <!-- ================================================== title bar -->
            <Grid Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/icon.ico" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock Text="Vibelight Valley Installer" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ================================================== hero -->
            <Border Background="{StaticResource Hero}" Padding="24,22">
                <StackPanel>
                    <TextBlock Text="Vibelight Valley" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#E4E0FA" FontSize="14" Margin="0,2,0,0" Text="VR Mod for Disney Dreamlight Valley"/>
                    <TextBlock Foreground="#B9B4DA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Stereo 6DOF view in any SteamVR headset. Play with your controller as usual."/>
                </StackPanel>
            </Border>

            <StackPanel Margin="20,16,20,8">
                <!-- ============================================== installer update banner -->
                <Border x:Name="SelfUpdateBanner" Visibility="Collapsed" Background="#2B2547" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel>
                        <Button x:Name="SelfUpdateButton" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="Update installer" Click="SelfUpdate_Click"/>
                        <TextBlock x:Name="SelfUpdateText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <!-- ============================================== game folder -->
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="GAME FOLDER"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button x:Name="BrowseButton" Style="{StaticResource BaseButton}" Content="Change…" Click="Browse_Click"/>
                                <Button x:Name="OpenFolderButton" Style="{StaticResource BaseButton}" Content="Open" Margin="6,0,0,0" Click="OpenFolder_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="GameDirText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================== status + actions -->
                <Border Style="{StaticResource CardBox}" Padding="16,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="VR MOD"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,2,10,0"/>
                            <TextBlock x:Name="StatusText" FontSize="18" FontWeight="SemiBold" Text="Checking…"/>
                        </StackPanel>
                        <TextBlock x:Name="DetailText" Style="{StaticResource MutedText}" Margin="20,4,0,0" TextWrapping="Wrap"/>

                        <DockPanel Margin="0,16,0,0">
                            <Button x:Name="UninstallButton" DockPanel.Dock="Right" Style="{StaticResource Danger}" Content="Uninstall"
                                    VerticalAlignment="Center" Click="Uninstall_Click"/>
                            <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="Install" HorizontalAlignment="Left"
                                    MinWidth="190" Click="Primary_Click"/>
                        </DockPanel>

                        <!-- progress while working -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,12"/>
                        <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" Click="EnabledSwitch_Click">
                            <StackPanel>
                                <TextBlock Text="Load VR when the game starts"/>
                                <TextBlock Style="{StaticResource MutedText}" Foreground="#B9B6CC" FontSize="11" Text="Off = the game starts completely unmodified. Applies at the next start."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ============================================== footer -->
                <DockPanel Margin="2,4,2,8">
                    <Button x:Name="LaunchButton" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="▶  Launch game" Click="Launch_Click"
                            ToolTip="Start SteamVR first, then the game"/>
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="LogsButton" Style="{StaticResource Link}" Content="Mod logs" Click="Logs_Click"/>
                        <Button x:Name="ConfigButton" Style="{StaticResource Link}" Content="Settings file" Click="Config_Click"/>
                        <Button Style="{StaticResource Link}" Content="Release notes" Click="Releases_Click"/>
                        <Button Style="{StaticResource Link}" Content="Installer log" Click="InstallerLog_Click"/>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
